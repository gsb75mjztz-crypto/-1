# Copy this file to .env (local dev) and configure real values in your
# hosting provider's environment settings for deployed environments.
# Never commit .env — see .gitignore.

# --- Database (Technical Architecture Section 3) --------------------------
# Postgres connection string. Docs specify Supabase or Neon; any standard
# Postgres connection string works via the pg driver adapter (lib/prisma.ts).
DATABASE_URL="postgresql://user:password@host:5432/investorhub"

# --- Auth (Technical Architecture Section 5, Legal Principles Section 4) --
# Generate with: npx auth secret
AUTH_SECRET=""
# Public URL of the deployment. Not required in most Vercel deployments
# (inferred automatically), but set explicitly for local dev / other hosts.
AUTH_URL="http://localhost:3000"
# SMTP connection string for the magic-link provider (any transactional
# email provider's SMTP credentials — e.g. Resend, Postmark, SES).
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="InvestorHub <noreply@example.com>"

# --- Cron (Technical Architecture Section 9, vercel.json) -----------------
# Shared secret checked by /api/cron/refresh-performance to reject requests
# that aren't from Vercel Cron. Generate any long random string.
CRON_SECRET=""

# --- Not yet wired — later Development Roadmap weeks ----------------------
# Performance data provider (Week 2). Requires the written licence
# confirmation covering commercial end-user display before use — see
# Legal Principles Section 5 and Data Strategy Section 9.
# FMP_API_KEY=""

# Newsletter ESP (Week 5) — e.g. Mailchimp/ConvertKit-class provider, per
# PRD FR-9.
# NEWSLETTER_API_KEY=""
